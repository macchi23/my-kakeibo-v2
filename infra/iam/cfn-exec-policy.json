{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideUsEast1",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ResolveDeployTimeParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:*:parameter/cdk-bootstrap/kakeibov2/version",
        "arn:aws:ssm:us-east-1:*:parameter/my-kakeibo-v2/budget-email"
      ]
    },
    {
      "Sid": "CognitoCreateTaggedUserPool",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "my-kakeibo-v2"
        }
      }
    },
    {
      "Sid": "CognitoManageProjectUserPool",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:SetUserPoolMfaConfig",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:AddCustomAttributes",
        "cognito-idp:ListTagsForResource",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:ListUserPoolClients",
        "cognito-idp:ListUserPoolClientSecrets"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:*:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "my-kakeibo-v2"
        }
      }
    },
    {
      "Sid": "BudgetsProjectBudget",
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:ViewBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::*:budget/my-kakeibo-v2-*"
    },
    {
      "Sid": "BudgetsReadBillingView",
      "Effect": "Allow",
      "Action": "billing:GetBillingViewData",
      "Resource": "arn:aws:billing::*:billingview/*"
    },
    {
      "Sid": "IamManageProjectRoleWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::*:role/my-kakeibo-v2/*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${aws:PrincipalAccount}:policy/my-kakeibo-v2-boundary"
        }
      }
    },
    {
      "Sid": "IamAttachOnlyLambdaBasicExecution",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::*:role/my-kakeibo-v2/*",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${aws:PrincipalAccount}:policy/my-kakeibo-v2-boundary",
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "IamReadAndTagProjectRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole*",
        "iam:List*RolePolicies",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::*:role/my-kakeibo-v2/*"
    },
    {
      "Sid": "IamPassProjectRoleToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/my-kakeibo-v2/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyRoleWithoutProjectBoundary",
      "Effect": "Deny",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${aws:PrincipalAccount}:policy/my-kakeibo-v2-boundary"
        }
      }
    },
    {
      "Sid": "DenyBoundaryRemoval",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    },
    {
      "Sid": "DenyProjectPolicyEdit",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:aws:iam::*:policy/my-kakeibo-v2-boundary",
        "arn:aws:iam::*:policy/my-kakeibo-v2-cfn-exec",
        "arn:aws:iam::*:policy/my-kakeibo-v2-cfn-exec-app"
      ]
    }
  ]
}
